# Fresh checkout only: copy to .env; do not overwrite an existing private configuration.
# Keep secrets out of Git/public archives. Private team handoff: see docs/handoff.md.
GEMINI_API_KEY=
# Configurable: availability must be checked for the actual API project.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_CONCURRENCY=16
GEMINI_MAX_CALLS_PER_ANALYSIS=50
GEMINI_TIMEOUT_SECONDS=30
# Small-project defaults. The private full run explicitly used 500 / 160 MiB / cap 1000.
ANALYSIS_CHUNK_SIZE=50
ANALYSIS_CONTEXT_OVERLAP=10
MAX_IMPORT_SIZE_BYTES=52428800
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=data
DB_FILENAME=vkyd.db
# Optional; required only for the Telegram worker, never for the web playground.
TELEGRAM_BOT_TOKEN=
# Explicitly allow one group ID before polling can send any messages.
TELEGRAM_ALLOWED_CHAT_IDS=
